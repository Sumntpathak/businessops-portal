# Recepto environment
# Copy this file to .env. Replace every "change-me" value before starting.
#
# Host-side database URL. Compose overrides the hostname to "postgres" inside containers.
DATABASE_URL=postgresql://recepto:recepto@localhost:5432/recepto
# Host-side Redis URL. Compose overrides the hostname to "redis" inside containers.
REDIS_URL=redis://localhost:6379
# At least 32 random characters used to sign authentication sessions.
SESSION_SECRET=change-me-use-at-least-32-random-characters

# Postgres container credentials. On a real server, change these from the defaults —
# docker-compose.yml reads them for the postgres, migrate, web, and voice services.
POSTGRES_DB=recepto
POSTGRES_USER=recepto
POSTGRES_PASSWORD=change-me-strong-password

# Public domains for the Caddy reverse proxy (production only — see docker-compose.prod.yml
# and Caddyfile). Caddy auto-issues HTTPS certificates for these via Let's Encrypt, so they
# must be real domains with DNS A records pointing at this server's IP before startup.
WEB_DOMAIN=app.example.com
VOICE_DOMAIN=voice.example.com

# Twilio project credentials and the E.164 number assigned to Recepto.
TWILIO_ACCOUNT_SID=change-me
TWILIO_AUTH_TOKEN=change-me
TWILIO_NUMBER=+15555550100

# Azure OpenAI Realtime endpoint, credential, and deployment/model name.
AZURE_REALTIME_URL=https://example.openai.azure.com
AZURE_REALTIME_KEY=change-me
AZURE_REALTIME_MODEL=gpt-realtime-mini
# Azure SIP connector (optional). Set AZURE_SIP_ENABLED=true plus the webhook
# signing secret (whsec_...) captured when registering the realtime.call.incoming
# webhook. Requires the Azure resource to be in East US 2 or Sweden Central.
AZURE_SIP_ENABLED=false
AZURE_WEBHOOK_SECRET=

# Model and web-search provider credentials.
ANTHROPIC_API_KEY=change-me
BRAVE_SEARCH_API_KEY=change-me

# Google OAuth and Calendar integration credentials.
# Production: register https://<WEB_DOMAIN>/api/auth/callback/google as an authorized
# redirect URI in the Google Cloud Console for this client ID, then set it here.
GOOGLE_CLIENT_ID=change-me
GOOGLE_CLIENT_SECRET=change-me
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# Public origins used for redirects, webhooks, and Twilio media streams.
# Local/dev: http://localhost:3000 and http://localhost:3001 (or a tunnel URL).
# Production: must match WEB_DOMAIN / VOICE_DOMAIN above, over https:// — e.g.
#   PUBLIC_WEB_URL=https://app.example.com
#   PUBLIC_VOICE_URL=https://voice.example.com
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_VOICE_URL=http://localhost:3001
