{
    "name":  "recepto",
    "version":  "0.1.0",
    "private":  true,
    "packageManager":  "pnpm@10.33.0",
    "engines": {
        "node": ">=20"
    },
    "scripts":  {
                    "dev":  "docker compose up --build",
                    "build":  "pnpm --filter @recepto/shared build \u0026\u0026 pnpm --filter @recepto/db build \u0026\u0026 pnpm --filter @recepto/calendar build \u0026\u0026 pnpm --filter @recepto/web build \u0026\u0026 pnpm --filter @recepto/voice build",
                    "db:generate":  "pnpm --filter @recepto/db db:generate",
                    "db:migrate":  "pnpm --filter @recepto/db db:migrate",
                    "db:studio":  "pnpm --filter @recepto/db db:studio",
                    "db:seed":  "pnpm --filter @recepto/db db:seed"
                },
    "devDependencies":  {
                            "typescript":  "^5.7.3"
                        }
}
